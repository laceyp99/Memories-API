[
  {
    "name": "create_memory",
    "description": "Create a new memory in the Memories API.",
    "parameters": {
      "type": "object",
      "properties": {
        "content": { "type": "string", "description": "Text content of the memory." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "List of tags to categorize the memory." },
        "memory_type": { "type": "string", "enum": ["preference", "fact", "identity", "event"], "description": "Type of the memory." },
        "status": { "type": "string", "enum": ["active", "invalid", "deleted"], "description": "Status of the memory; default is active." }
      },
      "required": ["content", "tags"]
    }
  },
  {
    "name": "query_memories",
    "description": "Query memories with filters and pagination.",
    "parameters": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["active", "invalid", "deleted"] },
        "memory_type": { "type": "string", "enum": ["preference", "fact", "identity", "event"] },
        "tag": { "type": "string" },
        "q": { "type": "string" },
        "sort": { "type": "string", "enum": ["id", "created_at", "updated_at", "last_accessed_at"], "default": "id" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
        "offset": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "required": []
    }
  },
  {
    "name": "update_memory",
    "description": "Update an existing memory by ID.",
    "parameters": {
      "type": "object",
      "properties": {
        "memory_id": { "type": "integer", "description": "ID of the memory to update." },
        "content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "memory_type": { "type": "string", "enum": ["preference", "fact", "identity", "event"] },
        "status": { "type": "string", "enum": ["active", "invalid", "deleted"] }
      },
      "required": ["memory_id"]
    }
  },
  {
    "name": "delete_memory",
    "description": "Delete a memory by ID and return the removed object.",
    "parameters": {
      "type": "object",
      "properties": {
        "memory_id": { "type": "integer" }
      },
      "required": ["memory_id"]
    }
  },
  {
    "name": "read_memory",
    "description": "Read a memory by its ID.",
    "parameters": {
      "type": "object",
      "properties": {
        "memory_id": { "type": "integer" }
      },
      "required": ["memory_id"]
    }
  }
]
